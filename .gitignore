# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Jupyter / notebook
.ipynb_checkpoints/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local logs and temp files
*.log
*.tmp
*.temp

# Ignore all contents under data
data/**

# Generated pipeline outputs
output/**
!output/.gitkeep

# Lightweight review exports can be committed, but keep heavy media ignored.
review_outputs/
!review_outputs/
!review_outputs/**
review_outputs/**/*.mp4
review_outputs/**/*.wav
review_outputs/**/*.mov
review_outputs/**/*.m4a
review_outputs/**/*.aac
