{
  "job_id": "flvZ6jEj3VU",
  "source_manifest": "translation_input/manifest.json",
  "segments": [
    {
      "segment_id": "seg_0001",
      "start": 0.052,
      "end": 4.092,
      "text": "みなさん、こんにちは。パット・デニスです。次の1分で、Codexの設定方法をお見せします。"
    },
    {
      "segment_id": "seg_0002",
      "start": 4.632,
      "end": 9.372,
      "text": "まず最初に、自分がどんな仕事をしているかを伝えます。すると、私向けに"
    },
    {
      "segment_id": "seg_0003",
      "start": 9.732,
      "end": 15.332,
      "text": "調整された体験になります。2つ目は、進めていたプロジェクトや、ほかの生産性向上ツール、"
    },
    {
      "segment_id": "seg_0004",
      "start": 15.452,
      "end": 20.992,
      "text": "コーディングツールです。それらをワンクリックでCodexに移せます。3つ目は、"
    },
    {
      "segment_id": "seg_0005",
      "start": 21.732,
      "end": 25.532,
      "text": "プラグインを設定することです。Codexに、文書の作成や、"
    },
    {
      "segment_id": "seg_0006",
      "start": 27.152,
      "end": 33.632,
      "text": "スプレッドシートやプレゼンの作成、ブラウザーの利用、パソコンの操作、さらに"
    },
    {
      "segment_id": "seg_0007",
      "start": 34.052,
      "end": 41.292,
      "text": "カレンダーやメール、Slack、Google Driveへのアクセスも許可します。そうすれば、Codexと話すだけで"
    },
    {
      "segment_id": "seg_0008",
      "start": 41.492,
      "end": 45.612,
      "text": "こうしたいろいろなシステムと自然に連携できます。新しいサイドバーもすっきりしていて、"
    },
    {
      "segment_id": "seg_0009",
      "start": 46.152,
      "end": 49.612,
      "text": "すぐ使えますし、これまで進めていたいろいろなプロジェクトも、"
    },
    {
      "segment_id": "seg_0010",
      "start": 49.612,
      "end": 52.512,
      "text": "たとえばClaudeの中にあったものも、ここですぐ使えます。"
    },
    {
      "segment_id": "seg_0011",
      "start": 54.372,
      "end": 55.852,
      "text": "次にできるのは、すぐ仕事に取りかかることです。"
    },
    {
      "segment_id": "seg_0012",
      "start": 56.672,
      "end": 59.892,
      "text": "Codexに、次の会議の準備を頼みます。"
    },
    {
      "segment_id": "seg_0013",
      "start": 60.492,
      "end": 63.052,
      "text": "GoogleカレンダーやGmailを検索して、"
    },
    {
      "segment_id": "seg_0014",
      "start": 63.612,
      "end": 66.212,
      "text": "Slackも確認して、要点のメモを作ってもらいます。"
    },
    {
      "segment_id": "seg_0015",
      "start": 66.392,
      "end": 68.532,
      "text": "そうすれば、次の営業電話にしっかり備えられます。"
    },
    {
      "segment_id": "seg_0016",
      "start": 69.452,
      "end": 72.272,
      "text": "これで設定は完了です。接続されたコンテキストと、"
    },
    {
      "segment_id": "seg_0017",
      "start": 72.912,
      "end": 76.272,
      "text": "役立つ最初のワークフローが、約60秒でそろいます。"
    }
  ]
}
