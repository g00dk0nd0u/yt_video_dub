{
  "job_id": "HFM3se4lNiw",
  "source_manifest": "translation_input/manifest.json",
  "segments": [
    {
      "segment_id": "seg_0001",
      "start": 0.657,
      "end": 3.227,
      "text": "本日、Codexアプリを発表します。"
    },
    {
      "segment_id": "seg_0002",
      "start": 3.62,
      "end": 5.771,
      "text": "これで、あなたの"
    },
    {
      "segment_id": "seg_0003",
      "start": 5.771,
      "end": 8.28,
      "text": "プロジェクト管理と実作業の委任をCodexにまとめられます。"
    },
    {
      "segment_id": "seg_0004",
      "start": 8.99,
      "end": 10.902,
      "text": "いくつものターミナルを行き来せず、"
    },
    {
      "segment_id": "seg_0005",
      "start": 10.902,
      "end": 12.525,
      "text": "ひとつの司令塔で"
    },
    {
      "segment_id": "seg_0006",
      "start": 12.525,
      "end": 13.8,
      "text": "エージェントを実行し、見守れます。"
    },
    {
      "segment_id": "seg_0007",
      "start": 14.58,
      "end": 15.4,
      "text": "仕組みをご覧ください。"
    },
    {
      "segment_id": "seg_0008",
      "start": 16.68,
      "end": 18.08,
      "text": "左側には私のプロジェクトがあります。"
    },
    {
      "segment_id": "seg_0009",
      "start": 18.68,
      "end": 19.587,
      "text": "それぞれについて、"
    },
    {
      "segment_id": "seg_0010",
      "start": 19.587,
      "end": 21.4,
      "text": "Codexが完了したタスクを確認でき、"
    },
    {
      "segment_id": "seg_0011",
      "start": 22.0,
      "end": 23.92,
      "text": "いまこの瞬間も動いているものがあります。"
    },
    {
      "segment_id": "seg_0012",
      "start": 24.6,
      "end": 25.694,
      "text": "右側は、この"
    },
    {
      "segment_id": "seg_0013",
      "start": 25.694,
      "end": 26.56,
      "text": "メイン会話画面です。"
    },
    {
      "segment_id": "seg_0014",
      "start": 27.38,
      "end": 28.814,
      "text": "まずは、私が作っている"
    },
    {
      "segment_id": "seg_0015",
      "start": 28.814,
      "end": 29.48,
      "text": "このiOSアプリです。"
    },
    {
      "segment_id": "seg_0016",
      "start": 29.5,
      "end": 31.576,
      "text": "ISSをリアルタイムで追跡していて、"
    },
    {
      "segment_id": "seg_0017",
      "start": 31.576,
      "end": 34.42,
      "text": "ここに新機能を追加したいとします。"
    },
    {
      "segment_id": "seg_0018",
      "start": 35.21,
      "end": 36.919,
      "text": "私は入力してもいいし、むしろ"
    },
    {
      "segment_id": "seg_0019",
      "start": 36.919,
      "end": 38.851,
      "text": "思いついたことをそのまま話して指示できます。"
    },
    {
      "segment_id": "seg_0020",
      "start": 38.851,
      "end": 40.708,
      "text": "NASAの"
    },
    {
      "segment_id": "seg_0021",
      "start": 40.708,
      "end": 43.16,
      "text": "今日の天文写真を表示する新画面を追加して。"
    },
    {
      "segment_id": "seg_0022",
      "start": 44.52,
      "end": 46.358,
      "text": "それだけで、Codexが今すぐ"
    },
    {
      "segment_id": "seg_0023",
      "start": 46.358,
      "end": 47.365,
      "text": "その作業を引き受け、"
    },
    {
      "segment_id": "seg_0024",
      "start": 47.365,
      "end": 49.44,
      "text": "適切なAPIを見つけて実装してくれます。"
    },
    {
      "segment_id": "seg_0025",
      "start": 50.74,
      "end": 52.285,
      "text": "その間に、しばらく前から"
    },
    {
      "segment_id": "seg_0026",
      "start": 52.285,
      "end": 53.782,
      "text": "移行したかった別プロジェクトを"
    },
    {
      "segment_id": "seg_0027",
      "start": 53.782,
      "end": 54.7,
      "text": "見てみましょう。"
    },
    {
      "segment_id": "seg_0028",
      "start": 54.72,
      "end": 57.272,
      "text": "ここではCodexが依存関係を"
    },
    {
      "segment_id": "seg_0029",
      "start": 57.272,
      "end": 60.232,
      "text": "一式更新していて、その作業の中で"
    },
    {
      "segment_id": "seg_0030",
      "start": 60.232,
      "end": 62.945,
      "text": "WebSocketsから"
    },
    {
      "segment_id": "seg_0031",
      "start": 62.945,
      "end": 63.506,
      "text": "WebRTCへ"
    },
    {
      "segment_id": "seg_0032",
      "start": 63.506,
      "end": 66.254,
      "text": "音声対音声の連携を移行しています。"
    },
    {
      "segment_id": "seg_0033",
      "start": 66.254,
      "end": 68.139,
      "text": "こうした作業には時間がかかり、"
    },
    {
      "segment_id": "seg_0034",
      "start": 68.139,
      "end": 69.171,
      "text": "何分どころか何時間も、"
    },
    {
      "segment_id": "seg_0035",
      "start": 69.171,
      "end": 70.72,
      "text": "特に大きなコードベースでは"
    },
    {
      "segment_id": "seg_0036",
      "start": 70.72,
      "end": 72.255,
      "text": "なおさらです。つまり、"
    },
    {
      "segment_id": "seg_0037",
      "start": 72.255,
      "end": 74.328,
      "text": "これはソフトウェア開発の進め方を"
    },
    {
      "segment_id": "seg_0038",
      "start": 74.328,
      "end": 75.48,
      "text": "大きく変えます。"
    },
    {
      "segment_id": "seg_0039",
      "start": 75.48,
      "end": 77.41,
      "text": "これからはエージェントを見守り、"
    },
    {
      "segment_id": "seg_0040",
      "start": 77.41,
      "end": 79.648,
      "text": "終わったら確認するだけでいいのです。"
    },
    {
      "segment_id": "seg_0041",
      "start": 79.648,
      "end": 81.761,
      "text": "では最初の作業に戻りましょう。"
    },
    {
      "segment_id": "seg_0042",
      "start": 81.761,
      "end": 83.707,
      "text": "ここではCodexがどんなふうに"
    },
    {
      "segment_id": "seg_0043",
      "start": 83.707,
      "end": 84.68,
      "text": "問題に取り組み、"
    },
    {
      "segment_id": "seg_0044",
      "start": 84.7,
      "end": 86.425,
      "text": "どんな手順を踏んでいるか、"
    },
    {
      "segment_id": "seg_0045",
      "start": 86.425,
      "end": 88.313,
      "text": "そして進捗が見えてきます。"
    },
    {
      "segment_id": "seg_0046",
      "start": 88.313,
      "end": 90.12,
      "text": "そして完了です。では"
    },
    {
      "segment_id": "seg_0047",
      "start": 90.12,
      "end": 91.718,
      "text": "右側をクリックすると差分が見えます。"
    },
    {
      "segment_id": "seg_0048",
      "start": 91.718,
      "end": 93.715,
      "text": "Swiftコードのどこが変わったかを"
    },
    {
      "segment_id": "seg_0049",
      "start": 93.715,
      "end": 94.58,
      "text": "正確に確認できます。"
    },
    {
      "segment_id": "seg_0050",
      "start": 95.04,
      "end": 96.989,
      "text": "行ごとにコメントを残して"
    },
    {
      "segment_id": "seg_0051",
      "start": 96.989,
      "end": 99.226,
      "text": "フィードバックしたり、再修正を頼んだり、"
    },
    {
      "segment_id": "seg_0052",
      "start": 99.226,
      "end": 101.558,
      "text": "問題なければそのままマージできます。"
    },
    {
      "segment_id": "seg_0053",
      "start": 101.558,
      "end": 103.206,
      "text": "もっと深く確認したければ、"
    },
    {
      "segment_id": "seg_0054",
      "start": 103.206,
      "end": 104.26,
      "text": "変更内容を"
    },
    {
      "segment_id": "seg_0055",
      "start": 104.44,
      "end": 106.486,
      "text": "Xcodeで開けますが、今回はそのまま"
    },
    {
      "segment_id": "seg_0056",
      "start": 106.486,
      "end": 108.4,
      "text": "ここからアプリをビルドして実行します。"
    },
    {
      "segment_id": "seg_0057",
      "start": 109.62,
      "end": 111.266,
      "text": "Codexアプリでの開発は、"
    },
    {
      "segment_id": "seg_0058",
      "start": 111.266,
      "end": 112.729,
      "text": "ものづくりをもっと楽しくします。"
    },
    {
      "segment_id": "seg_0059",
      "start": 112.729,
      "end": 113.46,
      "text": "つまり、"
    },
    {
      "segment_id": "seg_0060",
      "start": 113.46,
      "end": 115.465,
      "text": "コード編集に多くの時間を使うのではなく、"
    },
    {
      "segment_id": "seg_0061",
      "start": 115.465,
      "end": 117.44,
      "text": "どう作りたいかを考えることに"
    },
    {
      "segment_id": "seg_0062",
      "start": 117.64,
      "end": 119.01,
      "text": "より集中できるのです。"
    },
    {
      "segment_id": "seg_0063",
      "start": 119.01,
      "end": 121.18,
      "text": "iOSシミュレーターを画面に出してみましょう。"
    },
    {
      "segment_id": "seg_0064",
      "start": 121.84,
      "end": 123.582,
      "text": "はい、こちらです。私はたった"
    },
    {
      "segment_id": "seg_0065",
      "start": 123.582,
      "end": 124.888,
      "text": "一文をCodexに渡しただけで、"
    },
    {
      "segment_id": "seg_0066",
      "start": 124.888,
      "end": 126.34,
      "text": "この新機能全体を"
    },
    {
      "segment_id": "seg_0067",
      "start": 126.44,
      "end": 128.342,
      "text": "作ってくれました。すごいですよね。"
    },
    {
      "segment_id": "seg_0068",
      "start": 128.342,
      "end": 130.56,
      "text": "では、別のプロジェクトに切り替えます。"
    },
    {
      "segment_id": "seg_0069",
      "start": 130.74,
      "end": 132.753,
      "text": "これはWebベースのフィットネス"
    },
    {
      "segment_id": "seg_0070",
      "start": 132.753,
      "end": 134.96,
      "text": "トラッカーです。こうした見た目重視の作業では、"
    },
    {
      "segment_id": "seg_0071",
      "start": 135.16,
      "end": 136.988,
      "text": "自分が作っている体験に、もっと"
    },
    {
      "segment_id": "seg_0072",
      "start": 136.988,
      "end": 138.676,
      "text": "近い場所で進めたいんです。なので"
    },
    {
      "segment_id": "seg_0073",
      "start": 138.676,
      "end": 139.52,
      "text": "右上を"
    },
    {
      "segment_id": "seg_0074",
      "start": 139.52,
      "end": 141.446,
      "text": "クリックすると会話を"
    },
    {
      "segment_id": "seg_0075",
      "start": 141.446,
      "end": 143.532,
      "text": "こんなふうにポップアウトできて、"
    },
    {
      "segment_id": "seg_0076",
      "start": 143.532,
      "end": 146.02,
      "text": "Codexを連れていき、その場で口頭指示できます。"
    },
    {
      "segment_id": "seg_0077",
      "start": 147.18,
      "end": 149.496,
      "text": "バーを動かして進捗を表現して。"
    },
    {
      "segment_id": "seg_0078",
      "start": 149.496,
      "end": 151.088,
      "text": "すると数秒後には"
    },
    {
      "segment_id": "seg_0079",
      "start": 151.088,
      "end": 152.68,
      "text": "変更内容が"
    },
    {
      "segment_id": "seg_0080",
      "start": 152.84,
      "end": 155.0,
      "text": "そのままライブで反映されます。本当に"
    },
    {
      "segment_id": "seg_0081",
      "start": 155.0,
      "end": 157.32,
      "text": "チームメイトと協力しているような"
    },
    {
      "segment_id": "seg_0082",
      "start": 157.32,
      "end": 159.48,
      "text": "感覚です。さて次に、Codexアプリの"
    },
    {
      "segment_id": "seg_0083",
      "start": 159.78,
      "end": 161.809,
      "text": "強力な要素のひとつがスキルです。"
    },
    {
      "segment_id": "seg_0084",
      "start": 161.809,
      "end": 163.995,
      "text": "スキルを使うとCodexは"
    },
    {
      "segment_id": "seg_0085",
      "start": 163.995,
      "end": 165.4,
      "text": "お気に入りのツールとつながれます。"
    },
    {
      "segment_id": "seg_0086",
      "start": 166.2,
      "end": 167.935,
      "text": "実際、このアプリ自体も"
    },
    {
      "segment_id": "seg_0087",
      "start": 167.935,
      "end": 170.017,
      "text": "Figmaスキルを使って実装されました。"
    },
    {
      "segment_id": "seg_0088",
      "start": 170.017,
      "end": 172.168,
      "text": "裏側ではMCPが自動で使われ、"
    },
    {
      "segment_id": "seg_0089",
      "start": 172.168,
      "end": 174.18,
      "text": "必要な準備まで整えてくれます。"
    },
    {
      "segment_id": "seg_0090",
      "start": 174.76,
      "end": 175.94,
      "text": "デザインも少しお見せします。"
    },
    {
      "segment_id": "seg_0091",
      "start": 176.96,
      "end": 178.617,
      "text": "これがホーム画面で、"
    },
    {
      "segment_id": "seg_0092",
      "start": 178.617,
      "end": 180.049,
      "text": "たとえば一つのコンポーネントを"
    },
    {
      "segment_id": "seg_0093",
      "start": 180.049,
      "end": 182.083,
      "text": "クリックすると、その"
    },
    {
      "segment_id": "seg_0094",
      "start": 182.083,
      "end": 183.74,
      "text": "余白やテキストスタイルなどが"
    },
    {
      "segment_id": "seg_0095",
      "start": 183.74,
      "end": 186.0,
      "text": "その場で定義されているのが分かります。"
    },
    {
      "segment_id": "seg_0096",
      "start": 186.37,
      "end": 187.763,
      "text": "つまりCodexは"
    },
    {
      "segment_id": "seg_0097",
      "start": 187.763,
      "end": 188.36,
      "text": "スクリーンショットを見ているのではありません。"
    },
    {
      "segment_id": "seg_0098",
      "start": 189.04,
      "end": 190.906,
      "text": "実際にはデザインファイルの"
    },
    {
      "segment_id": "seg_0099",
      "start": 190.906,
      "end": 192.711,
      "text": "構造を読み取り、それらの"
    },
    {
      "segment_id": "seg_0100",
      "start": 192.711,
      "end": 194.637,
      "text": "変数まで含めて本物のコードを生成しています。"
    },
    {
      "segment_id": "seg_0101",
      "start": 194.637,
      "end": 195.6,
      "text": "私たちのデザインシステムを使って。"
    },
    {
      "segment_id": "seg_0102",
      "start": 196.18,
      "end": 198.34,
      "text": "だからこそ、デザインと高い精度で一致するのです。"
    },
    {
      "segment_id": "seg_0103",
      "start": 199.2,
      "end": 200.807,
      "text": "もちろん、自分用にも"
    },
    {
      "segment_id": "seg_0104",
      "start": 200.807,
      "end": 202.58,
      "text": "チーム用にも独自のスキルを作れます。"
    },
    {
      "segment_id": "seg_0105",
      "start": 202.97,
      "end": 204.4,
      "text": "だからワークフローにぴったり合わせられます。"
    },
    {
      "segment_id": "seg_0106",
      "start": 204.92,
      "end": 206.82,
      "text": "さらにCodexアプリの本当に強い点は、"
    },
    {
      "segment_id": "seg_0107",
      "start": 206.93,
      "end": 208.665,
      "text": "こうしたスキルを"
    },
    {
      "segment_id": "seg_0108",
      "start": 208.665,
      "end": 209.56,
      "text": "自動化にもできることです。"
    },
    {
      "segment_id": "seg_0109",
      "start": 210.26,
      "end": 211.792,
      "text": "たとえば、ある周期で"
    },
    {
      "segment_id": "seg_0110",
      "start": 211.792,
      "end": 213.12,
      "text": "回したい作業があるとします。"
    },
    {
      "segment_id": "seg_0111",
      "start": 213.7,
      "end": 216.245,
      "text": "Sentryのアラート整理や、"
    },
    {
      "segment_id": "seg_0112",
      "start": 216.245,
      "end": 219.338,
      "text": "Linearのバグやチケット対応かもしれません。"
    },
    {
      "segment_id": "seg_0113",
      "start": 219.66,
      "end": 221.057,
      "text": "そうした作業も今では"
    },
    {
      "segment_id": "seg_0114",
      "start": 221.057,
      "end": 222.105,
      "text": "裏で進めてもらいながら、"
    },
    {
      "segment_id": "seg_0115",
      "start": 222.105,
      "end": 223.1,
      "text": "自分は開発に集中できます。"
    },
    {
      "segment_id": "seg_0116",
      "start": 224.2,
      "end": 226.111,
      "text": "Codexアプリには、ほかにも多くの機能があります。"
    },
    {
      "segment_id": "seg_0117",
      "start": 226.111,
      "end": 228.022,
      "text": "たとえば、"
    },
    {
      "segment_id": "seg_0118",
      "start": 228.022,
      "end": 229.34,
      "text": "分離された環境での作業です。"
    },
    {
      "segment_id": "seg_0119",
      "start": 229.56,
      "end": 231.447,
      "text": "それはworktreeと呼ばれ、"
    },
    {
      "segment_id": "seg_0120",
      "start": 231.447,
      "end": 233.091,
      "text": "各エージェントにコードのコピーを渡せるので、"
    },
    {
      "segment_id": "seg_0121",
      "start": 233.091,
      "end": 234.663,
      "text": "競合や"
    },
    {
      "segment_id": "seg_0122",
      "start": 234.663,
      "end": 235.328,
      "text": "競合や"
    },
    {
      "segment_id": "seg_0123",
      "start": 235.328,
      "end": 236.4,
      "text": "環境破壊を心配せずに済みます。"
    },
    {
      "segment_id": "seg_0124",
      "start": 237.46,
      "end": 239.134,
      "text": "どんな作業でも委任できます。"
    },
    {
      "segment_id": "seg_0125",
      "start": 239.134,
      "end": 241.065,
      "text": "特に時間のかかるものは、"
    },
    {
      "segment_id": "seg_0126",
      "start": 241.065,
      "end": 242.16,
      "text": "クラウド上のCodexへ"
    },
    {
      "segment_id": "seg_0127",
      "start": 242.5,
      "end": 243.96,
      "text": "同じインターフェースのまま任せられます。"
    },
    {
      "segment_id": "seg_0128",
      "start": 244.78,
      "end": 245.94,
      "text": "今回はほんの簡単な紹介でした。"
    },
    {
      "segment_id": "seg_0129",
      "start": 246.44,
      "end": 247.94,
      "text": "Codexアプリは、まったく新しい"
    },
    {
      "segment_id": "seg_0130",
      "start": 247.94,
      "end": 248.9,
