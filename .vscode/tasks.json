      "args": [
        "user_tools/run_resume.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "yt_video_dub: rebuild range 7-20",
      "type": "shell",
      "command": ".venv/bin/python",
      "args": [
        "user_tools/run_rebuild_range.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
